<Window
    x:Class="Microsoft.Psi.PsiStudio.Windows.AnnotationSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cmd="http://www.galasoft.ch/mvvmlight"
    xmlns:conv="clr-namespace:Microsoft.Psi.Visualization.Converters;assembly=Microsoft.Psi.Visualization.Windows"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:local="clr-namespace:Microsoft.Psi.PsiStudio.Windows"
    Title="Search Annotations"
    Width="600"
    Height="500"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Annotation Stream Selection -->
        <GroupBox Grid.Row="0" Header="Annotation Stream" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    Grid.Column="0"
                    ItemsSource="{Binding AvailableStreams}"
                    SelectedItem="{Binding SelectedStream}"
                    Margin="0,0,8,0"
                    Padding="4"
                    Height="30" />
                <Button
                    Grid.Column="1"
                    Command="{Binding LoadStreamCommand}"
                    Content="Load"
                    Width="80"
                    Height="30"
                    Padding="8,4" />
            </Grid>
        </GroupBox>

        <!-- Search Criteria -->
        <GroupBox Grid.Row="1" Header="Search Criteria" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Text Box -->
                <TextBox
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,8,0"
                    Padding="4"
                    Height="30"
                    VerticalAlignment="Center" />

                <!-- Require All Keywords Checkbox -->
                <CheckBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Content="Require all keywords"
                    IsChecked="{Binding RequireAllKeywords}"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center" />

                <!-- Search Buttons -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button
                        Command="{Binding SearchNextCommand}"
                        Content="Find Next"
                        Width="100"
                        Height="30"
                        Padding="8,4"
                        Margin="0,0,4,0" />
                    <Button
                        Command="{Binding SearchPreviousCommand}"
                        Content="Find Previous"
                        Width="100"
                        Height="30"
                        Padding="8,4"
                        Margin="0,0,4,0" />
                    <Button
                        Command="{Binding SearchAllCommand}"
                        Content="Find All"
                        Width="100"
                        Height="30"
                        Padding="8,4" />
					<CheckBox
	                      Content="Set as selection"
	                      IsChecked="{Binding SetAsSelection}"
	                      Margin="125,0,0,0"
	                      VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Status Message -->
        <TextBlock
            Grid.Row="2"
            Text="{Binding Status}"
            Foreground="#666666"
            Margin="0,0,0,8"
            MinHeight="20" />

        <!-- Current Result Display -->
        <GroupBox
            Grid.Row="3"
            Header="Search Results"
            Margin="0,0,0,8"
            Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibilityConverter}}"            >
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Results List -->
                <ListBox
                    Name="FindAllResults"
                    Grid.Row="1"
                    ItemsSource="{Binding AllResults}"
                    SelectedItem="{Binding CurrentResult, Mode=TwoWay}"
                    MouseDoubleClick="FindAllResults_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Text}" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Interval.Left}" Margin="8,0,0,0" Foreground="#666666" />
                                <TextBlock Grid.Column="2" Text="{Binding MatchScore, StringFormat=P2}" Margin="8,0,0,0" Foreground="#666666" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
