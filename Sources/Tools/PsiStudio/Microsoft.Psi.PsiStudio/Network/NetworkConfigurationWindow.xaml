<Window x:Class="Microsoft.Psi.Visualization.Windows.NetworkConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="clr-namespace:Xceed.Wpf.Toolkit.PropertyGrid;assembly=Xceed.Wpf.Toolkit"
        ShowInTaskbar="False"
        Title="Psi Studio Network Settings"
        Width="350"
        Height="400"
        WindowStartupLocation="CenterOwner" 
        BorderBrush="DodgerBlue"
        BorderThickness="1"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="10">
        <Grid.Resources>
            <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="10,2,2,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="22" />
                <Setter Property="Width" Value="80" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <xctk:PropertyGrid
            Name="PropertyGrid"
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,4,0,0"
            NameColumnWidth="300"
            ShowSortOptions="False"
            ShowSearchBox="False"
            ShowTitle="False"/>

        <Grid Grid.IsSharedSizeScope="True" Grid.Row="0" Height="auto" VerticalAlignment="Top">
            <Grid.Resources>
                <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>

                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Width" Value="180" />
                </Style>

                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Width" Value="180" />
                </Style>

                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Height" Value="22" />
                    <Setter Property="Width" Value="80" />
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0">Is Active</Label>
            <CheckBox Grid.Row="0" Grid.Column="1" Name="IsNetworkActive"></CheckBox>
            <Label Grid.Row="1" Grid.Column="0">Broadcasting Audio</Label>
            <CheckBox Grid.Row="1" Grid.Column="1" Name="IsAudioActive"></CheckBox>
            <Label Grid.Row="2" Grid.Column="0">Is Using TCPWriters</Label>
            <CheckBox Grid.Row="2" Grid.Column="1" Name="IsUsingTCPWriters"></CheckBox>
            <Label Grid.Row="3" Grid.Column="0">Endpoint Address</Label>
            <TextBox Grid.Row="3" Grid.Column="1" Name="EndpointAddress" Margin="5,10,4,5" Foreground="{StaticResource ForegroundBrush}"/>
            <Label Grid.Row="4" Grid.Column="0">RendezVous Port</Label>
            <TextBox Grid.Row="4" Grid.Column="1" Name="RendezVousPort" Margin="5,10,4,5" Foreground="{StaticResource ForegroundBrush}"/>
            <Label Grid.Row="5" Grid.Column="0">RendezVous Server Address</Label>
            <TextBox Grid.Row="5" Grid.Column="1" Name="RendezVousAddress" Margin="5,10,4,5" Foreground="{StaticResource ForegroundBrush}"/>
            <Label Grid.Row="6" Grid.Column="0">Exporter Starting Port</Label>
            <TextBox Grid.Row="6" Grid.Column="1" Name="ExporterStartingPort" Margin="5,10,4,5" Foreground="{StaticResource ForegroundBrush}"/>
            <Label Grid.Row="7" Grid.Column="0">Process Name</Label>
            <TextBox Grid.Row="7" Grid.Column="1" Name="ProcessNameOverriding" Margin="5,10,4,5" Foreground="{StaticResource ForegroundBrush}"/>
            <Label Grid.Row="8" Grid.Column="0">Command Process Name</Label>
            <TextBox Grid.Row="8" Grid.Column="1" Name="CommandProcessName" Margin="5,10,4,5" Foreground="{StaticResource ForegroundBrush}"/>
        </Grid>
        
        <StackPanel Name="ButtonsStackPanel" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Name="SaveButton" Click="SaveButtonClick" IsDefault="True" Margin="0,5,10,0">Save</Button>
            <Button IsCancel="True" Margin="2,5,0,0">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
