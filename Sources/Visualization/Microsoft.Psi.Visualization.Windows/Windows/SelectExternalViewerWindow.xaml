<Window x:Class="Microsoft.Psi.Visualization.Windows.SelectExternalViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Width" Value="80" />
            <Setter Property="Margin" Value="5" />
        </Style>
    </Window.Resources>

    <StackPanel Orientation="Vertical" Margin="10" MaxWidth="400">
		<TextBlock Margin="5" TextWrapping="Wrap" FontSize="12" Name="WarningLine1"/>
		<TextBlock Margin="5" TextWrapping="Wrap" FontSize="12" Name="WarningLine2"/>
        <TextBlock Margin="5" TextWrapping="Wrap" FontSize="12">
            <Run Text="Select an external application to visualize:"/>
		</TextBlock>
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Name="ExecutablePathTextBox" Grid.Column="0" Padding="5" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <Button Name="BrowseButton" Grid.Column="1" Click="BrowseButton_Click">Browse...</Button>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Name="OKButton" Click="OKButton_Click" IsDefault="True" IsEnabled="False">OK</Button>
            <Button Name="CancelButton" Click="CancelButton_Click" IsCancel="True">Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
