<Window
    x:Class="Microsoft.Psi.PsiStudio.Windows.BatchProcessingTasksWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Batch Processing Tasks"
    Width="900"
    Height="520"
    MinWidth="700"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Task tracks" Margin="0,0,0,8">
                <ListBox
                    Margin="8"
                    DisplayMemberPath="TrackName"
                    ItemsSource="{Binding Tracks}"
                    SelectedItem="{Binding SelectedTrack, Mode=TwoWay}" />
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Track statistics" Margin="0,0,0,8">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        Text="{Binding SelectedTrackStatistics}"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        FontSize="13" />
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                Width="130"
                Height="28"
                Margin="0,0,8,0"
                Content="Export to json"
                Click="ExportToJsonButtonClick" />
            <Button
                Width="90"
                Height="28"
                Margin="0,0,8,0"
                Content="Close"
                IsCancel="True"
                Click="CloseButtonClick" />
            <Button
                Width="90"
                Height="28"
                Content="Run"
                Click="RunButtonClick" />
        </StackPanel>
    </Grid>
</Window>